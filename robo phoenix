double CalculateSLByPoints(bool isBuy, double entryPrice)
{
   if(!UseFixedSL) return 0.0;
   
   // ✅ NOVO: Se usar lógica simplificada, calcular SL baseado em ATR
   if(UseSimplifiedSignalLogic)
   {
      // Obter parâmetros atuais (podem vir da pesquisa automática)
      int    currentATRPeriod  = ATRPeriod;
      double currentATRStopMult = ATR_StopMult;
      
      if(EnableRSIAtrMacdParamSearch && !g_rsiAtrMacdSearchCompleted)
      {
         currentATRPeriod  = g_RSIAtrMacdConfigs[g_currentRSIAtrMacdConfigIndex].atrPeriod;
         currentATRStopMult = g_RSIAtrMacdConfigs[g_currentRSIAtrMacdConfigIndex].atrStopMult;
      }
      else if(EnableRSIAtrMacdParamSearch && g_rsiAtrMacdSearchCompleted && UseBestRSIAtrMacdConfigAfterTest)
      {
         currentATRPeriod  = g_RSIAtrMacdConfigs[g_bestRSIAtrMacdConfigIndex].atrPeriod;
         currentATRStopMult = g_RSIAtrMacdConfigs[g_bestRSIAtrMacdConfigIndex].atrStopMult;
      }
      
      double atr[1];
      if(CopyBuffer(g_atrHandle, 0, 0, 1, atr) < 1)
      {
         Print("❌ Erro ao copiar ATR para SL");
         return 0.0;
      }
      
      double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
      double slDistance = currentATRStopMult * atr[0];
      
      double slPrice = 0.0;
      if(isBuy)
         slPrice = entryPrice - slDistance;
      else
         slPrice = entryPrice + slDistance;
      
      Print("✅ SL ATR-based: ", (isBuy?"BUY":"SELL"), " | ATR=", DoubleToString(atr[0], 5),
            " | Mult=", currentATRStopMult, " | Distance=", DoubleToString(slDistance, 5),
            " | SL=", DoubleToString(slPrice, 5));
      
      return slPrice;
   }
   
   // Lógica original baseada em pontos fixos
   int slPoints = FixedSL_Points;
   if(slPoints <= 0) return 0.0;
   
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double slDistance = slPoints * point;
   
   if(isBuy)
   {
      double slPrice = entryPrice - slDistance;
      Print("✅ SL BUY calculado: Entry=", DoubleToString(entryPrice, 5), " - SL=", DoubleToString(slPrice, 5), 
            " (", slPoints, " pontos = ", DoubleToString(slDistance, 5), ")");
      return slPrice;
   }
   else
   {
      double slPrice = entryPrice + slDistance;
      Print("✅ SL SELL calculado: Entry=", DoubleToString(entryPrice, 5), " + SL=", DoubleToString(slPrice, 5), 
            " (", slPoints, " pontos = ", DoubleToString(slDistance, 5), ")");
      return slPrice;
   }
}

