// ✅✅✅ FUNÇÃO CORRIGIDA: UpdateQ_NOP (NÃO CONTA COMO PERDA)
// ======================================================================
void UpdateQ_NOP(int state)
{
   if(state < 0) return;
  
   Print("📊 NOP registrado para estado ", state, " (não conta como visita/perda real)");
   
   if(ExcludeNOPFromVisits)
   {
      // NOP não incrementa contadores de visita/perda
      Print("✅ NOP excluído de contagens (configuração ativa)");
   }
   
   if(ArraySize(g_Q) > state * NUM_ACTIONS)
   {
      int idx = state * NUM_ACTIONS;
      double oldQ = g_Q[idx];
      double newQ = oldQ - 0.02;  // ✅ PENALIDADE MODERADA: -0.02 (BTC M5 precisa de NOP mais tolerante)
      g_Q[idx] = CompressQValue(newQ);
      
      g_memoryDirty = true;
   }
}

// ======================================================================
// ✅✅✅ ChooseAction - COM SISTEMA CORRIGIDO (VERSÃO MODIFICADA)
// ======================================================================
int ChooseAction(int state)
{
   if(state < 0 || state >= NUM_STATES)
   {
      Print("❌ Estado inválido: ", state);
      return 0;
   }
   
   // ✅ NOVO: Usar lógica simplificada RSI+MACD se habilitada
   if(UseSimplifiedSignalLogic)
   {
      int simplifiedSignal = GetSimplifiedSignal();
      
      // 🚨 FIX CRÍTICO: REMOVER verificações de bloqueio duplicadas
      // OnTick já verifica IsStateBlocked antes de chamar ChooseAction
      // Verificações aqui causavam paradas mesmo com estado OK
      
      if(simplifiedSignal == 1)
         g_statusMessage = "📈 SINAL SIMPLIFICADO: BUY (RSI+MACD)";
      else if(simplifiedSignal == 2)
         g_statusMessage = "📉 SINAL SIMPLIFICADO: SELL (RSI+MACD)";
      else
         g_statusMessage = "⏸️ SINAL SIMPLIFICADO: NOP (sem sinal claro)";
      
      Print("🎯 Sinal simplificado: ", (simplifiedSignal==0?"NOP":(simplifiedSignal==1?"BUY":"SELL")));
      return simplifiedSignal;
   }
   
   // 🚨 FIX CRÍTICO: REMOVER verificação de bloqueio duplicada
   // OnTick já verifica antes de chamar esta função
   
   if(ArraySize(g_Q) <= state * NUM_ACTIONS + 2)
   {
      Print("❌ Array Q não inicializado");
      return 0;
   }
   
   
   if(g_consecutiveLosses >= 12)
   {
   }
   
   // 🚨 FIX CRÍTICO: EXPLORAÇÃO FORÇADA PARA ESTADOS NOVOS (100%)
   // Estados com 0 visitas SEMPRE exploram para garantir primeira visita
   // Sem isso, estado pode ficar preso em NOP e nunca ser descoberto
   if(g_stateVisits[state] < MinStateVisitsToTrade)
   {
      // 100% exploração - SEMPRE opera em estados novos
      int randomAction = 1 + (MathRand() % 2);  // BUY ou SELL aleatório
      Print("🔍 EXPLORAÇÃO FORÇADA (estado novo ", state, " com ", g_stateVisits[state], " visitas): Ação ", randomAction);
      g_statusMessage = StringFormat("🔍 Exploração forçada (estado %d novo)", state);
      return randomAction;
   }
   
   // Para estados conhecidos, usar taxa de exploração normal
   double eps = g_currentExplorationRate;
   
   // ⚠️ CAP REMOVIDO - Permitir exploração natural sem limite artificial
   // (Cap de 70% após 100 trades removido para permitir descoberta adequada de estados)

   if(((double)MathRand() / 32767.0) < eps) 
   {
      int randomAction = 1 + (MathRand() % 2);
      Print("🔍 EXPLORAÇÃO: Ação aleatória ", randomAction, " | Estado: ", state);
      g_statusMessage = "🔍 Exploração (ação aleatória)";
      return randomAction;
   }

   double best = -DBL_MAX;
   int bestA = 0;

   for(int a = 1; a < NUM_ACTIONS; a++)
   {
      int idx = state * NUM_ACTIONS + a;
      if(idx < ArraySize(g_Q) && g_Q[idx] > best)
      {
         best = g_Q[idx];
         bestA = a;
      }
   }
   
   // ✅ FIX BUG #3: Verificação de bounds antes de acessar Q-table
   int nopIdx = state * NUM_ACTIONS + 0;
   double nopQ = 0;
   if(nopIdx >= 0 && nopIdx < ArraySize(g_Q))
      nopQ = g_Q[nopIdx];
   
   // ⚠️ CORREÇÃO: Tornar NOP MENOS atrativo - exigir estados MUITO ruins
   double winRate = CalculateWinRate(state);
   if(g_stateVisits[state] >= MinVisitsForBlockDecision && winRate < 0.10)  // ✅ REDUZIDO: 10% ao invés de 15% (apenas estados PÉSSIMOS)
   {
      bestA = 0;
      Print("🤔 NOP escolhido (estado muito ruim, win rate: ", DoubleToString(winRate*100,1), "%)");
      g_statusMessage = "NOP (estado muito ruim)";
   }
   else if(nopQ > best * 8.0 && bestA > 0)  // ✅ AUMENTADO: NOP precisa ser 8x melhor ao invés de 5x (favorecer trades)
   {
      bestA = 0;
      Print("🤔 NOP escolhido (superioridade: ", nopQ, " vs ", best, ")");
      g_statusMessage = "NOP (melhor opção)";
   }
   else if(best <= -50.0)  // ✅ MANTIDO: -50 (ações precisam estar MUITO ruins)
   {
      bestA = 0;
      Print("🤔 NOP escolhido (ações de trade muito ruins: ", best, ")");
      g_statusMessage = "NOP (ações ruins)";
   }
   else if(bestA == 1 || bestA == 2)
   {
      if(bestA == 1) g_statusMessage = "BUY recomendado";
      else g_statusMessage = "SELL recomendado";
   }
   else
   {
      g_statusMessage = "NOP (indecisão)";
   }
   
   Print("💡 DECISÃO: Estado ", state, " | Ação ", 
         (bestA==0?"NOP":(bestA==1?"BUY":"SELL")), 
         " | Q = ", bestA==0 ? nopQ : best,
         " | Visitas: ", g_stateVisits[state],
         " | Win Rate: ", DoubleToString(winRate*100,1), "%");
   
   // 🚨 VERIFICAÇÃO CRÍTICA: Alertar se Q-values parecem não estar sendo usados
   if(g_stateVisits[state] >= 20 && MathAbs(best) < 0.01 && MathAbs(nopQ) < 0.01)
   {
      Print("⚠️⚠️⚠️ ALERTA: Estado ", state, " com 20+ visitas mas Q-values próximos de zero!");
      Print("   Isso indica que UpdateQ pode não estar sendo chamado ou rewards são muito pequenos");
      Print("   Q[BUY]: ", g_Q[state*NUM_ACTIONS+1], " | Q[SELL]: ", g_Q[state*NUM_ACTIONS+2], " | Q[NOP]: ", nopQ);
   }
   
   return bestA;
}

