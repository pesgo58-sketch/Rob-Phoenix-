// ======================================================================

// ✅✅✅ 1️⃣ FUNÇÃO UNIFICADA PARA BLOQUEAR ESTADO (CORRIGIDA)
void BlockState(int state)
{
    if(state < 0 || state >= NUM_STATES) return;

    // ✅ FIX #33: REMOVIDO cooldown de 1 hora que impedia bloqueios
    // Estados que atingem critério devem ser bloqueados IMEDIATAMENTE
    
    // Verificar se já está bloqueado
    if(g_stateBlocked[state])
    {
        return;  // Já está bloqueado, nada a fazer
    }
    
    // 🚨 PROTEÇÃO CRÍTICA: Nunca bloquear se já temos muitos estados bloqueados
    // Isso previne DEADLOCK TOTAL onde robô fica sem estados disponíveis
    int currentBlocked = CountBlockedStates();
    double blockedPercentage = SafeDivide((double)currentBlocked, (double)NUM_STATES, 0.0);
    
    if(blockedPercentage >= 0.80)  // 80% ou mais bloqueados
    {
        Print("⚠️ PROTEÇÃO ANTI-DEADLOCK: NÃO bloqueando estado ", state);
        Print("   Já existem ", currentBlocked, " estados bloqueados (", 
              DoubleToString(blockedPercentage*100, 1), "% de ", NUM_STATES, ")");
        Print("   Limite de segurança: 80%");
        return;  // NÃO BLOQUEAR - prevenir travamento total
    }

    // ✅ FIX #33: Verificações de visitas e loss rate removidas (redundantes)
    // ShouldBlockState() já verificou tudo isso antes de chamar BlockState()
    
    // ✅ BLOQUEAR ESTADO IMEDIATAMENTE
    g_stateBlocked[state] = true;
    g_stateLastBlockTime[state] = TimeCurrent();
    
    // Incrementar contador de bloqueios
    g_stateBlockCount[state]++;
    
    // Marcar que este estado já foi bloqueado e registrar timestamp do primeiro bloqueio
    if(!g_stateWasBlockedBefore[state])
    {
        g_stateWasBlockedBefore[state] = true;
        g_stateBlockTime[state] = TimeCurrent();
    }
    
    // Log sempre visível (não depende de EnableBlockingDebugLogs)
    double winRate = CalculateWinRate(state);
    double lossRate = SafeDivide(g_stateLosses[state], g_stateVisits[state], 0.0);
    
    Print("🚫 ESTADO BLOQUEADO: ", state, 
          " | Visitas: ", g_stateVisits[state],
          " | Wins: ", g_stateWins[state],
          " | Losses: ", g_stateLosses[state], 
          " | WinRate: ", DoubleToString(winRate*100, 1), "%",
          " | LossRate: ", DoubleToString(lossRate*100, 1), "%",
          " | Bloqueios totais: ", g_stateBlockCount[state]);
    
    g_memoryDirty = true;
    InvalidateHUDCache();
}

// ══════════════════════════════════════════════════════════════════════
// 🔄 FUNÇÃO: Reativar Estados Bloqueados (SE HABILITADO)
// ══════════════════════════════════════════════════════════════════════
void ReactivateStatesIfEnabled()
{
   if(!EnableStateReactivation)
   {
      return;  // Reativação desabilitada
   }
   
   int reactivated = 0;
   datetime currentTime = TimeCurrent();
   
   for(int state = 0; state < NUM_STATES; state++)
   {
      if(!g_stateBlocked[state]) continue;  // Não está bloqueado
      
      int visits = g_stateVisits[state];
      if(visits < MinVisitsForBlockDecision) continue;  // Poucas visitas
      
      int wins = g_stateWins[state];
      double winRate = SafeDivide((double)wins, (double)visits, 0.0);
      
      // Critério 1: Win rate melhorou para >= threshold
      if(winRate >= ReactivationWinRate)
      {
         g_stateBlocked[state] = false;
         g_stateLastUnblockTime[state] = currentTime;
         reactivated++;
         
         if(EnableBlockingDebugLogs)
         {
            Print("🔄 REATIVADO (WinRate): Estado ", state,
                  " | Visitas: ", visits,
                  " | WinRate: ", DoubleToString(winRate*100, 1), "%");
         }
         continue;
      }
      
      // Critério 2: Passou tempo suficiente desde bloqueio
      if(ReactivationDays > 0)
      {
         datetime blockTime = g_stateBlockTime[state];
         if(blockTime > 0)
         {
            int daysSinceBlock = (int)((currentTime - blockTime) / 86400);
            
            if(daysSinceBlock >= ReactivationDays)
            {
               g_stateBlocked[state] = false;
               g_stateLastUnblockTime[state] = currentTime;
               reactivated++;
               
               if(EnableBlockingDebugLogs)
               {
                  Print("🔄 REATIVADO (Tempo): Estado ", state,
                        " | Dias desde bloqueio: ", daysSinceBlock,
                        " | WinRate: ", DoubleToString(winRate*100, 1), "%");
               }
            }
         }
      }
   }
   
   if(reactivated > 0)
   {
      Print("✅ ", reactivated, " estados reativados (EnableStateReactivation=true)");
      InvalidateHUDCache();  // Atualizar HUD
      g_memoryDirty = true;  // Salvar mudanças
   }
}

// ✅✅✅ 2️⃣ ESTADOS BLOQUEADOS PERMANECEM BLOQUEADOS PERMANENTEMENTE (SE REATIVAÇÃO DESABILITADA)
// Sem função de desbloqueio - conforme solicitado pelo usuário


// ✅✅✅ 3️⃣ FUNÇÃO PARA VERIFICAR SE UM ESTADO DEVE SER BLOQUEADO (CORRIGIDA)
bool ShouldBlockState(int state)
{
    if(state < 0 || state >= NUM_STATES) return false;
    
    int visits = g_stateVisits[state];
    int losses = g_stateLosses[state];
    int wins = g_stateWins[state];
    
    // ✅ MODO AGRESSIVO: Bloqueio mais rápido e rigoroso
    int minVisits = AggressiveLearningMode ? 5 : MinVisitsForBlockDecision;
    double lossThreshold = AggressiveLearningMode ? 0.50 : BlockLossRateThreshold;
    
    if(visits < minVisits) 
    {
        // 🔍 DEBUG: Estado sem visitas suficientes (log reduzido)
        // Print("🔍 BLOCK DEBUG: State=", state, " | Visits=", visits, " < MinVisits=", minVisits, " → SEM DADOS SUFICIENTES (não bloqueia)");
        return false;
    }
    
    double lossRate = SafeDivide((double)losses, (double)visits, 0.0);
    double winRate = SafeDivide((double)wins, (double)visits, 0.0);
    
    // ✅ CRITÉRIO 1: Taxa de perda muito alta
    bool highLossRate = (lossRate >= lossThreshold);
    
    // ✅ CRITÉRIO 2: Win rate muito baixa (novo critério adicional)
    bool lowWinRate = (winRate < 0.35); // Bloqueia se win rate < 35%
    
    // ✅ CRITÉRIO 3: Sharpe Ratio muito baixo (se habilitado)
    bool lowSharpe = false;
    double sharpe = 0.0;
    if(EnableSharpeFilter)
    {
        int trades = g_stateWins[state] + g_stateLosses[state];
        if(trades >= MinTradesForSharpe)
        {
            sharpe = CalculateSharpeRatio(state);
            lowSharpe = (sharpe < MaxSharpeToBlock);
        }
    }
    
    // 🔍 DEBUG: Log detalhado apenas quando bloqueio vai acontecer
    bool shouldBlock = (highLossRate || lowWinRate || lowSharpe);
    if(shouldBlock)
    {
        Print("🚫 BLOQUEANDO Estado ", state, 
              " | Visits=", visits,
              " | Wins=", wins,
              " | Losses=", losses,
              " | WinRate=", DoubleToString(winRate*100, 1), "%",
              " | LossRate=", DoubleToString(lossRate*100, 1), "%",
              " | LossRateTH=", DoubleToString(lossThreshold*100, 1), "%",
              " | Sharpe=", DoubleToString(sharpe, 2),
              " | HighLoss?=", highLossRate,
              " | LowWinRate?=", lowWinRate,
              " | LowSharpe?=", lowSharpe,
              " | AggressiveMode=", AggressiveLearningMode);
    }
    
    // ✅ Bloquear se OU taxa de perda alta OU win rate baixa OU Sharpe muito baixo
    return shouldBlock;
}

