// ✅✅✅ FUNÇÃO ComputeRewardFromTrade (ATUALIZADA)
// ======================================================================
double ComputeRewardFromTrade(double profit)
{
   if(UseSimpleRewardSystem)
   {
      if(profit > 0) return RewardWin;
      else return RewardLoss;
   }
   
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double profit_points = SafeDivide(profit, (LotSize * point * 100), 0.0);
   
   if(profit > 0)
   {
      return 1.0 + profit_points / 100.0;
   }
   else
   {
      return -1.0 - MathAbs(profit_points) / 200.0;
   }
}

// ======================================================================
// ✅✅✅ FUNÇÃO GetStateQualityScore - Cálculo numérico de qualidade
// ======================================================================
// Retorna um score numérico (-2.0 a 2.0) para uso em multiplicadores de lote
// Esta função mantém a lógica original baseada em Q-values e win rate
double GetStateQualityScore(int state)
{
   if(state < 0 || state >= NUM_STATES) return 0.0;
   if(ArraySize(g_stateVisits) <= state) return 0.0;
   if(ArraySize(g_Q) <= state * NUM_ACTIONS + 2) return 0.0;
   
   if(g_stateVisits[state] < 2) return 0.0;
   
   double buyQ  = g_Q[state * NUM_ACTIONS + 1];
   double sellQ = g_Q[state * NUM_ACTIONS + 2];
   double nopQ  = g_Q[state * NUM_ACTIONS + 0];
   
   double bestTradeQ = MathMax(buyQ, sellQ);
   
   if(nopQ > bestTradeQ * 3.0)
   {
      double penalizedQuality = (bestTradeQ - nopQ) / 5.0;
      return MathMax(penalizedQuality, -2.0);
   }
   
   double quality = bestTradeQ / 10.0;
   
   if(g_stateVisits[state] >= MinVisitsForBlockDecision)
   {
      double winRate = CalculateWinRate(state);
      double lossRate = 1.0 - winRate;
      
      if(lossRate > 0.6)
      {
         quality -= (lossRate - 0.6) * 3.0;
      }
      
      if(winRate > 0.7 && g_stateVisits[state] >= MinVisitsForBlockDecision)
      {
         quality += (winRate - 0.7) * 2.0;
      }
   }
   
   if(quality > 2.0) quality = 2.0;
   if(quality < -2.0) quality = -2.0;
   
   return quality;
}

// ══════════════════════════════════════════════════════════════════════
// 🎯 FUNÇÃO GetStateQuality - Classificação por categorias
// ══════════════════════════════════════════════════════════════════════
// Retorna a categoria de qualidade de um estado (BLOCKED/BAD/NEUTRAL/GOOD/ELITE)
// 
// FLUXO DE CLASSIFICAÇÃO:
// 1. Se estado bloqueado E sistema de bloqueio ativo → STATE_QUALITY_BLOCKED
// 2. Se visitas < MinVisitsForQualityDecision → STATE_QUALITY_NEUTRAL (dados insuficientes)
// 3. Com base no win rate:
//    - >= EliteWinRateThreshold (70%) → STATE_QUALITY_ELITE
//    - >= GoodWinRateThreshold (55%) → STATE_QUALITY_GOOD
//    - >= BadWinRateThreshold (35%) → STATE_QUALITY_NEUTRAL
//    - < BadWinRateThreshold (35%) → STATE_QUALITY_BAD
//
// IMPORTANTE: Estados bloqueados são SEMPRE classificados como BLOCKED,
// independentemente do número de visitas, garantindo que apareçam nas estatísticas
ENUM_STATE_QUALITY GetStateQuality(int state)
{
   // Validações básicas
   if(state < 0 || state >= NUM_STATES) return STATE_QUALITY_NEUTRAL;
   if(ArraySize(g_stateVisits) <= state) return STATE_QUALITY_NEUTRAL;
   
   // ✅ PRIORIDADE 1: Verificar bloqueio ANTES de qualquer outra condição
   // Estados bloqueados são SEMPRE classificados como BLOCKED, mesmo com poucas visitas
   if(EnableUnifiedBlockingSystem && g_stateBlocked[state])
   {
      return STATE_QUALITY_BLOCKED;
   }
   
   // ✅ PRIORIDADE 2: Verificar se há visitas suficientes para classificação
   // Estados não bloqueados com poucas visitas são considerados NEUTRAL
   int visits = g_stateVisits[state];
   if(visits < MinVisitsForQualityDecision)
   {
      return STATE_QUALITY_NEUTRAL;
   }
   
   // ✅ PRIORIDADE 3: Classificar com base no win rate
   double winRate = CalculateWinRate(state);
   
   if(winRate >= EliteWinRateThreshold)
   {
      return STATE_QUALITY_ELITE;  // >= 70%
   }
   else if(winRate >= GoodWinRateThreshold)
   {
      return STATE_QUALITY_GOOD;   // >= 55%
   }
   else if(winRate >= BadWinRateThreshold)
   {
      return STATE_QUALITY_NEUTRAL; // >= 35%
   }
   else
   {
      return STATE_QUALITY_BAD;     // < 35%
   }
}

