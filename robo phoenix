// 🏆 FUNÇÃO: Atualizar contadores de qualidade de estados
// ══════════════════════════════════════════════════════════════════════
// Conta quantos estados existem em cada categoria de qualidade
// Esta função deve ser chamada periodicamente para atualizar o HUD
void UpdateQualityCounts()
{
   g_eliteStatesCount = 0;
   g_goodStatesCount = 0;
   g_neutralStatesCount = 0;
   g_badStatesCount = 0;
   g_blockedStatesCount = 0;
   
   for(int i = 0; i < NUM_STATES; i++)
   {
      ENUM_STATE_QUALITY quality = GetStateQuality(i);
      
      switch(quality)
      {
         case STATE_QUALITY_ELITE:
            g_eliteStatesCount++;
            break;
         case STATE_QUALITY_GOOD:
            g_goodStatesCount++;
            break;
         case STATE_QUALITY_NEUTRAL:
            g_neutralStatesCount++;
            break;
         case STATE_QUALITY_BAD:
            g_badStatesCount++;
            break;
         case STATE_QUALITY_BLOCKED:
            g_blockedStatesCount++;
            break;
      }
   }
}

// ══════════════════════════════════════════════════════════════════════
// 🏆 FUNÇÃO: Atualizar ranking de melhores e piores estados
// ══════════════════════════════════════════════════════════════════════
// Identifica os TOP 10 melhores e piores estados baseado em desempenho
void UpdateStateRankings()
{
   // Array temporário para armazenar todos os estados elegíveis
   StateRankInfo allStates[];
   int validCount = 0;
   
   ArrayResize(allStates, NUM_STATES);
   
   // Coletar todos os estados com visitas suficientes
   for(int i = 0; i < NUM_STATES; i++)
   {
      if(g_stateVisits[i] >= MinVisitsForQualityDecision)
      {
         allStates[validCount].state = i;
         allStates[validCount].winRate = CalculateWinRate(i);
         allStates[validCount].visits = g_stateVisits[i];
         // ✅ FIX #23: Usar g_stateProfitSum (lucro real acumulado) ao invés de g_stateAvgProfit
         allStates[validCount].profit = (ArraySize(g_stateProfitSum) > i) ? g_stateProfitSum[i] : 0.0;
         allStates[validCount].quality = GetStateQuality(i);
         validCount++;
      }
      // Incluir estados bloqueados mesmo com poucas visitas
      else if(g_stateBlocked[i] && g_stateVisits[i] > 0)
      {
         allStates[validCount].state = i;
         allStates[validCount].winRate = CalculateWinRate(i);
         allStates[validCount].visits = g_stateVisits[i];
         // ✅ FIX #23: Usar g_stateProfitSum (lucro real acumulado) ao invés de g_stateAvgProfit
         allStates[validCount].profit = (ArraySize(g_stateProfitSum) > i) ? g_stateProfitSum[i] : 0.0;
         allStates[validCount].quality = STATE_QUALITY_BLOCKED;
         validCount++;
      }
   }
   
   if(validCount == 0) return;
   
   // Ordenar por win rate (decrescente) para encontrar os melhores
   for(int i = 0; i < validCount - 1; i++)
   {
      for(int j = i + 1; j < validCount; j++)
      {
         if(allStates[j].winRate > allStates[i].winRate)
         {
            StateRankInfo temp = allStates[i];
            allStates[i] = allStates[j];
            allStates[j] = temp;
         }
      }
   }
   
   // Copiar TOP 10 melhores
   int bestCount = MathMin(10, validCount);
   for(int i = 0; i < bestCount; i++)
   {
      g_bestStates[i] = allStates[i];
   }
   // Zerar slots vazios
   for(int i = bestCount; i < 10; i++)
   {
      g_bestStates[i].state = -1;
      g_bestStates[i].visits = 0;
   }
   
   // Inverter ordem para pegar os piores
   for(int i = 0; i < validCount / 2; i++)
   {
      StateRankInfo temp = allStates[i];
      allStates[i] = allStates[validCount - 1 - i];
      allStates[validCount - 1 - i] = temp;
   }
   
   // Copiar TOP 10 piores
   int worstCount = MathMin(10, validCount);
   for(int i = 0; i < worstCount; i++)
   {
      g_worstStates[i] = allStates[i];
   }
   // Zerar slots vazios
   for(int i = worstCount; i < 10; i++)
   {
      g_worstStates[i].state = -1;
      g_worstStates[i].visits = 0;
   }
   
   g_lastRankingUpdate = TimeCurrent();
}

