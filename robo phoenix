// 🏆 FUNÇÃO: Exportar melhores e piores estados para arquivo
// ══════════════════════════════════════════════════════════════════════
void ExportBestAndWorstStates(int fileHandle)
{
   if(fileHandle == INVALID_HANDLE) return;
   
   // Atualizar rankings se necessário
   datetime currentTime = TimeCurrent();
   if(currentTime - g_lastRankingUpdate > g_rankingUpdateIntervalMinutes * 60 || g_lastRankingUpdate == 0)
   {
      UpdateStateRankings();
   }
   
   FileWrite(fileHandle, "");
   FileWrite(fileHandle, "🏆═══════════════════════════════════════════════════════════════");
   FileWrite(fileHandle, "   RANKING DE ESTADOS - TOP 10 MELHORES E PIORES");
   FileWrite(fileHandle, "═══════════════════════════════════════════════════════════════");
   FileWrite(fileHandle, "");
   
   // ✅ TOP 10 MELHORES ESTADOS
   FileWrite(fileHandle, "🥇 TOP 10 MELHORES ESTADOS (ELITE/BONS):");
   FileWrite(fileHandle, "─────────────────────────────────────────────────────────────");
   FileWrite(fileHandle, "Estado | Win Rate | Visitas | Lucro Total | Qualidade");
   FileWrite(fileHandle, "─────────────────────────────────────────────────────────────");
   
   int bestCount = 0;
   for(int i = 0; i < 10; i++)
   {
      if(g_bestStates[i].visits == 0) break;
      
      string qualityName = GetStateQualityName(g_bestStates[i].quality);
      string line = StringFormat("%6d | %7.2f%% | %7d | %11.2f | %s",
                                 g_bestStates[i].state,
                                 g_bestStates[i].winRate * 100.0,
                                 g_bestStates[i].visits,
                                 g_bestStates[i].profit,
                                 qualityName);
      FileWrite(fileHandle, line);
      bestCount++;
   }
   
   if(bestCount == 0)
   {
      FileWrite(fileHandle, "   (Nenhum estado com dados suficientes)");
   }
   
   FileWrite(fileHandle, "");
   
   // ✅ TOP 10 PIORES ESTADOS (RUINS/BLOQUEADOS)
   FileWrite(fileHandle, "🔴 TOP 10 PIORES ESTADOS (RUINS/BLOQUEADOS):");
   FileWrite(fileHandle, "─────────────────────────────────────────────────────────────");
   FileWrite(fileHandle, "Estado | Win Rate | Visitas | Lucro Total | Qualidade");
   FileWrite(fileHandle, "─────────────────────────────────────────────────────────────");
   
   int worstCount = 0;
   for(int i = 0; i < 10; i++)
   {
      if(g_worstStates[i].visits == 0) break;
      
      string qualityName = GetStateQualityName(g_worstStates[i].quality);
      string line = StringFormat("%6d | %7.2f%% | %7d | %11.2f | %s",
                                 g_worstStates[i].state,
                                 g_worstStates[i].winRate * 100.0,
                                 g_worstStates[i].visits,
                                 g_worstStates[i].profit,
                                 qualityName);
      FileWrite(fileHandle, line);
      worstCount++;
   }
   
   if(worstCount == 0)
   {
      FileWrite(fileHandle, "   (Nenhum estado com dados suficientes)");
   }
   
   FileWrite(fileHandle, "");
   FileWrite(fileHandle, "═══════════════════════════════════════════════════════════════");
}

