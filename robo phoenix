}

bool LoadBrainFromFile(string filename)
{
   if(!FileIsExist(filename, FILE_COMMON))
   {
      Print("❌ Arquivo não existe: ", filename);
      return false;
   }

   int h = FileOpen(filename, FILE_READ|FILE_BIN|FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("❌ Erro ao abrir arquivo: ", filename, " (Erro: ", GetLastError(), ")");
      return false;
   }

   int magic = FileReadInteger(h);
   int version = FileReadInteger(h);
   
   if(magic != FILE_MAGIC || version != FILE_VERSION)
   {
      Print("❌ Versão incompatível. Magic: ", magic, " (esperado: ", FILE_MAGIC, "), Versão: ", version, " (esperada: ", FILE_VERSION, ")");
      FileClose(h);
      return false;
   }
   
   // ✅ CORREÇÃO CRÍTICA: NÃO zera arrays antes de carregar!
   // Arrays já foram redimensionados em OnInit()
   // Apenas redimensiona se necessário, mas NÃO inicializa
   // Isso preserva dados de estados que não estão na lista ativa
   if(ArraySize(g_stateVisits) != NUM_STATES)
      ArrayResize(g_stateVisits, NUM_STATES);
   
   if(ArraySize(g_stateLosses) != NUM_STATES)
      ArrayResize(g_stateLosses, NUM_STATES);
   
   if(ArraySize(g_stateWins) != NUM_STATES)
      ArrayResize(g_stateWins, NUM_STATES);
   
   if(ArraySize(g_stateLastUpdate) != NUM_STATES)
      ArrayResize(g_stateLastUpdate, NUM_STATES);
   
   if(ArraySize(g_stateBlocked) != NUM_STATES)
      ArrayResize(g_stateBlocked, NUM_STATES);
   
   if(ArraySize(g_stateLastBlockTime) != NUM_STATES)
      ArrayResize(g_stateLastBlockTime, NUM_STATES);
   
   // ✅ NÃO zera g_Q[] - preserva valores existentes
   
   // 🔧 REGRA 3 — Converter para int se necessário
   int tempActiveStatesCount = FileReadInteger(h);
   g_activeStatesCount = tempActiveStatesCount;
   
   Print("📊 Carregando ", g_activeStatesCount, " estados salvos no arquivo...");
   if(g_activeStatesCount > MaxMemoryStates)
   {
      Print("⚠️ ALERTA: Arquivo contém ", g_activeStatesCount, " estados mas MaxMemoryStates = ", MaxMemoryStates);
      Print("🔄 Fix #24 reorganizará para manter apenas ", MaxMemoryStates, " mais recentes após carregar");
   }
   
   for(int i = 0; i < g_activeStatesCount; i++)
   {
      int state = FileReadInteger(h);
      
      if(state >= 0 && state < NUM_STATES)
      {
         g_activeStates[i] = state;
         g_stateVisits[state] = FileReadInteger(h);
         g_stateLosses[state] = FileReadInteger(h);
         g_stateWins[state] = FileReadInteger(h);
         g_stateLastUpdate[state] = FileReadInteger(h);
         g_stateBlocked[state] = (bool)FileReadInteger(h);
         g_stateLastBlockTime[state] = (datetime)FileReadLong(h);
         
         // ✅ FIX #46: Carregar lucro do estado (CRÍTICO!)
         g_stateProfitSum[state] = FileReadDouble(h);
         
         // Lê contador de bloqueios com validação para evitar overflow/corrupção
         int blockCount = FileReadInteger(h);
         // Limita contador a valor máximo razoável (0-10)
         g_stateBlockCount[state] = (blockCount < 0 || blockCount > 10) ? 0 : blockCount;
         
         for(int a = 0; a < NUM_ACTIONS; a++)
         {
            double qValue = FileReadDouble(h);
            g_Q[state * NUM_ACTIONS + a] = qValue;
         }
      }
      else
      {
         Print("⚠️ Estado inválido encontrado: ", state, " (ignorando)");
      }
   }
   
   // ✅ FIX #24: Se carregou mais estados que MaxMemoryStates, reorganizar IMEDIATAMENTE
   // Isso evita oscilação: arquivo pode ter 150 estados mas cache só comporta 100
   if(g_activeStatesCount > MaxMemoryStates)
   {
      Print("🔄 Arquivo contém ", g_activeStatesCount, " estados, mas MaxMemoryStates=", MaxMemoryStates);
      Print("   Reorganizando para manter apenas ", MaxMemoryStates, " mais recentes...");
      
      // Coletar todos estados carregados em array temporário
      int tempStates[];
      ArrayResize(tempStates, g_activeStatesCount);
      for(int i = 0; i < g_activeStatesCount; i++)
      {
         tempStates[i] = g_activeStates[i];
      }
      
      // Ordenar por g_stateLastUpdate (mais recentes primeiro) - Bubble sort
      for(int i = 0; i < g_activeStatesCount - 1; i++)
      {
         for(int j = i + 1; j < g_activeStatesCount; j++)
         {
            int stateA = tempStates[i];
            int stateB = tempStates[j];
            
            // Ordenar decrescente (mais recente primeiro)
            if(g_stateLastUpdate[stateB] > g_stateLastUpdate[stateA])
            {
               // Swap
               tempStates[i] = stateB;
               tempStates[j] = stateA;
            }
         }
      }
      
      // Manter apenas os MaxMemoryStates mais recentes no cache
      int originalCount = g_activeStatesCount;
      g_activeStatesCount = MaxMemoryStates;
      for(int i = 0; i < g_activeStatesCount; i++)
      {
         g_activeStates[i] = tempStates[i];
      }
      
      Print("✅ Cache reorganizado com ", g_activeStatesCount, " estados MAIS RECENTES");
      Print("   Total de estados descobertos preservados: ", originalCount);
      Print("   ⚠️ ", (originalCount - g_activeStatesCount), " estados mais antigos fora do cache (mas preservados na memória)");
   }
   
   g_currentExplorationRate = FileReadDouble(h);
   g_tradesToday = FileReadInteger(h);
   g_consecutiveLosses = FileReadInteger(h);
   g_totalTrades = FileReadInteger(h);
   g_totalWins = FileReadInteger(h);
   g_totalLosses = FileReadInteger(h);
   g_sumProfit = FileReadDouble(h);
   g_volumeMultiplier = FileReadDouble(h);
   g_totalStatesDiscovered = FileReadInteger(h);
   g_totalQUpdates = FileReadInteger(h);
   g_averageQValue = FileReadDouble(h);
   g_maxQValue = FileReadDouble(h);
   g_minQValue = FileReadDouble(h);
   
   int arraySize = FileReadInteger(h);
   ArrayResize(g_recentProfits, arraySize);
   FileReadArray(h, g_recentProfits, 0, arraySize);
   g_recentProfitsIndex = FileReadInteger(h);
   
   long firstTradeDate = FileReadLong(h);
   g_firstTradeDate = (datetime)firstTradeDate;
   g_highestProfit = FileReadDouble(h);
   g_lowestProfit = FileReadDouble(h);
   g_bestWinStreak = FileReadInteger(h);
   g_worstLossStreak = FileReadInteger(h);
   g_currentWinStreak = FileReadInteger(h);
   g_currentLossStreak = FileReadInteger(h);
   
   g_totalBuys = FileReadInteger(h);
   g_totalSells = FileReadInteger(h);
   g_buyWins = FileReadInteger(h);
   g_sellWins = FileReadInteger(h);
   g_buyProfit = FileReadDouble(h);
   g_sellProfit = FileReadDouble(h);
   
   ArrayResize(g_stateWinRate, NUM_STATES);
   FileReadArray(h, g_stateWinRate, 0, NUM_STATES);
   
   ArrayResize(g_stateAvgProfit, NUM_STATES);
   FileReadArray(h, g_stateAvgProfit, 0, NUM_STATES);
   
   // 🔧 CORREÇÃO CRÍTICA: Carregar TODOS os estados bloqueados (não apenas ativos)
   // Isso garante que estados bloqueados sejam preservados mesmo se não estiverem em g_activeStates[]
   FileReadArray(h, g_stateBlocked, 0, NUM_STATES);
   FileReadArray(h, g_stateBlockCount, 0, NUM_STATES);
   FileReadArray(h, g_stateLastBlockTime, 0, NUM_STATES);
   
   // ✅ BUG FIX: Carregar arrays de ranking de estados (TOP 10 melhores e piores)
   // Isso restaura o ranking entre reinícios do EA
   g_lastRankingUpdate = (datetime)FileReadLong(h);
   for(int i = 0; i < 10; i++)
   {
      g_bestStates[i].state = FileReadInteger(h);
      g_bestStates[i].winRate = FileReadDouble(h);
      g_bestStates[i].visits = FileReadInteger(h);
      g_bestStates[i].profit = FileReadDouble(h);
      g_bestStates[i].quality = (ENUM_STATE_QUALITY)FileReadInteger(h);
   }
   for(int i = 0; i < 10; i++)
   {
      g_worstStates[i].state = FileReadInteger(h);
      g_worstStates[i].winRate = FileReadDouble(h);
      g_worstStates[i].visits = FileReadInteger(h);
      g_worstStates[i].profit = FileReadDouble(h);
      g_worstStates[i].quality = (ENUM_STATE_QUALITY)FileReadInteger(h);
   }
   
   FileClose(h);
   
   // 🚨 FIX CRÍTICO: Reconstruir g_activeStates[] com os estados mais recentes
   // g_activeStatesCount foi setado pelo arquivo (total de estados salvos)
   // Mas pode ser maior que MaxMemoryStates
   // Então precisamos reconstruir o cache com os estados mais recentes
   
   int totalStatesLoaded = g_activeStatesCount;
   
   if(g_activeStatesCount > MaxMemoryStates)
   {
      Print("⚠️ Arquivo contém ", g_activeStatesCount, " estados, mas MaxMemoryStates=", MaxMemoryStates);
      Print("🔄 Reconstruindo cache com estados mais recentes...");
      
      // Encontrar os MaxMemoryStates estados mais recentes
      // Usar insertion sort parcial para eficiência
      g_activeStatesCount = 0;
      
      for(int s = 0; s < NUM_STATES; s++)
      {
         if(g_stateVisits[s] > 0)
         {
            // Se ainda há espaço, adiciona direto
            if(g_activeStatesCount < MaxMemoryStates)
            {
               g_activeStates[g_activeStatesCount] = s;
               g_activeStatesCount++;
            }
            else
            {
               // Encontrar estado mais antigo no cache e substituir se este for mais recente
               int oldestIdx = 0;
               int oldestTime = g_stateLastUpdate[g_activeStates[0]];
               
               for(int i = 1; i < MaxMemoryStates; i++)
               {
                  if(g_stateLastUpdate[g_activeStates[i]] < oldestTime)
                  {
                     oldestTime = g_stateLastUpdate[g_activeStates[i]];
                     oldestIdx = i;
                  }
               }
               
               // Se este estado é mais recente que o mais antigo no cache, substitui
               if(g_stateLastUpdate[s] > oldestTime)
               {
                  g_activeStates[oldestIdx] = s;
               }
            }
         }
      }
      
      Print("✅ Cache reconstruído com ", g_activeStatesCount, " estados mais recentes");
   }
   
   Print("✅ Memória carregada: ", g_activeStatesCount, " estados ativos (cache)");
   Print("   Total de estados descobertos preservados: ", totalStatesLoaded);
   Print("📊 Estados bloqueados: ", CountBlockedStates());
   Print("📊 Total de trades: ", g_totalTrades, " (Wins: ", g_totalWins, ", Losses: ", g_totalLosses, ")");
   Print("💰 Lucro Total carregado: ", DoubleToString(g_sumProfit, 2));
   
   // Verificar se exploração está desabilitada
   if(DisableExploration)
   {
      g_currentExplorationRate = 0.0;
      Print("🚫 EXPLORAÇÃO DESABILITADA - Modo exploitation only");
      Print("   Robô usará APENAS Q-learning (sem ações aleatórias)");
      Print("📊 Taxa de exploração: 0.0% (EXPLOITATION ONLY)");
   }
   else
   {
      Print("📊 Taxa de exploração: ", DoubleToString(g_currentExplorationRate * 100, 1), "% (FIXED)");
   }
   
   Print("🏆 Ranking carregado: ", (g_lastRankingUpdate > 0 ? "SIM" : "NÃO"), 
         " | Melhores: ", g_bestStates[0].visits, " visitas",
         " | Piores: ", g_worstStates[0].visits, " visitas");
   
   return true;
}

