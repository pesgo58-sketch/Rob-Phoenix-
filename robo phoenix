bool IsStateBlocked(int state)
{
    if(state < 0 || state >= NUM_STATES) return false;
    
    return g_stateBlocked[state];
}

// ✅✅✅ 6️⃣ FUNÇÃO PARA AVALIAR E ATUALIZAR BLOQUEIO DE ESTADO (CORRIGIDA)
void EvaluateAndUpdateBlockState(int state)
{
    if(state < 0 || state >= NUM_STATES) return;
    
    // ✅ FIX: Removido cooldown timer - avaliar estado IMEDIATAMENTE após cada trade
    // Isso garante que estados ruins sejam bloqueados assim que atingem os critérios
    
    bool shouldBeBlocked = ShouldBlockState(state);
    bool currentlyBlocked = g_stateBlocked[state];
    
    // 🚨 DIAGNÓSTICO DETALHADO: Por que estado não foi bloqueado?
    if(!shouldBeBlocked && !currentlyBlocked && EnableBlockingDebugLogs)
    {
        double winRate = CalculateWinRate(state);
        double lossRate = SafeDivide(g_stateLosses[state], g_stateVisits[state], 0.0);
        
        Print("🔍 DIAGNÓSTICO: Estado ", state, " NÃO bloqueado");
        Print("   Visitas: ", g_stateVisits[state], " (min: ", MinVisitsForBlockDecision, ")");
        Print("   Win rate: ", DoubleToString(winRate*100,1), "% (precisa <35% para bloquear)");
        Print("   Loss rate: ", DoubleToString(lossRate*100,1), "% (precisa >", DoubleToString(BlockLossRateThreshold*100,1), "% para bloquear)");
        Print("   Vitórias: ", g_stateWins[state], " | Perdas: ", g_stateLosses[state]);
    }
    
    if(shouldBeBlocked && !currentlyBlocked)
    {
        BlockState(state);
        
        // 🚨 LOG DETALHADO quando bloqueia
        double winRate = CalculateWinRate(state);
        double lossRate = SafeDivide(g_stateLosses[state], g_stateVisits[state], 0.0);
        Print("🚨 ESTADO BLOQUEADO: ", state);
        Print("   Razão: Win rate ", DoubleToString(winRate*100,1), "% | Loss rate ", DoubleToString(lossRate*100,1), "%");
        Print("   Histórico: ", g_stateWins[state], "W / ", g_stateLosses[state], "L / ", g_stateVisits[state], " visitas");
    }
    else if(!shouldBeBlocked && currentlyBlocked)
    {
        // States once blocked stay blocked (no unblocking)
    }
}

// ✅✅✅ 7️⃣ FUNÇÃO PARA AVALIAR TODOS OS ESTADOS ATIVOS (CORRIGIDA)
void EvaluateAllActiveStates()
{
    // ✅ FIX: Reduzido cooldown de 300s para 60s para avaliação mais frequente
    // Estados ruins serão detectados e bloqueados mais rapidamente
    static datetime lastFullEvaluation = 0;
    
    if(TimeCurrent() - lastFullEvaluation < 60)
        return;
    
    lastFullEvaluation = TimeCurrent();
    
    int blocked = 0;
    
    for(int i = 0; i < g_activeStatesCount; i++)
    {
        int state = g_activeStates[i];
        
        bool shouldBeBlocked = ShouldBlockState(state);
        bool currentlyBlocked = g_stateBlocked[state];
        
        if(shouldBeBlocked && !currentlyBlocked)
        {
            BlockState(state);
            blocked++;
        }
        // ✅ REMOVIDO: Lógica de desbloqueio - estados bloqueados permanecem bloqueados PERMANENTEMENTE
    }
    
    if(blocked > 0)
    {
      Print("📊 Avaliacao periodica de estados: ", blocked, " bloqueados");
      Print("📊 Total estados bloqueados: ", CountBlockedStates());
    }
}

