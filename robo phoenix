double CompressQValue(double value)
{
   if(!CompressQValues || QValuePrecision >= 4) return value;
   return NormalizeDouble(value, (int)QValuePrecision);
}

void AddActiveState(int state)
{
   if(state < 0 || state >= NUM_STATES) return;
   
   // 🚨 FIX #22: Verificar se estado JÁ FOI descoberto (tem visitas)
   // Evita mensagem "NOVO ESTADO" para estados que já existem mas foram removidos do cache
   bool isNewState = (g_stateVisits[state] == 0);
   
   // ✅ Verificar se estado já existe na lista ativa
   for(int i = 0; i < g_activeStatesCount; i++)
   {
      if(g_activeStates[i] == state)
      {
         // Estado já existe - apenas atualiza timestamp
         g_stateLastUpdate[state] = g_totalTrades;
         
         // ✅ FIX #31: Incrementar visitas SEMPRE que estado é calculado
         // NÃO apenas quando trade é executado (estava causando NOPs não serem contados)
         g_stateVisits[state]++;
         
         // 🔍 DEBUG #32: Log de incremento para diagnóstico
         if(g_stateVisits[state] % 10 == 0)  // Log a cada 10 visitas
         {
            Print("📊 Estado ", state, " atingiu ", g_stateVisits[state], " visitas");
         }
         return;
      }
   }
   
   // 🚨 FIX: REMOVIDA verificação de exploração
   // Motivo: Exploração mínima já garantida em OnInit (5%) e OnTick (boost para 15%)
   // AddActiveState deve SEMPRE aceitar novos estados descobertos
   // A decisão de explorar ou não é feita em ChooseAction, não aqui
   
   // ✅ Adicionar novo estado
   if(g_activeStatesCount < MaxMemoryStates)
   {
      g_activeStates[g_activeStatesCount] = state;
      g_activeStatesCount++;
      
      // ✅ FIX #31: Inicializar visitas = 1 (primeira vez que estado é usado)
      g_stateVisits[state] = 1;
      g_stateLastUpdate[state] = g_totalTrades;
      
      // ✅ Só imprimir "NOVO" se realmente for novo (sem visitas anteriores)
      if(isNewState)
      {
         Print("✨ NOVO ESTADO DESCOBERTO: ", state, " | Total estados ativos: ", g_activeStatesCount, " | Visitas: 1");
      }
      else
      {
         Print("🔄 Estado readicionado ao cache: ", state, " | Total ativos: ", g_activeStatesCount, " | Visitas anteriores preservadas");
      }
   }
   else
   {
      int oldestIndex = 0;
      int oldestTime = INT_MAX;
      
      for(int i = 0; i < g_activeStatesCount; i++)
      {
         int stateIdx = g_activeStates[i];
         if(g_stateLastUpdate[stateIdx] < oldestTime)
         {
            oldestTime = g_stateLastUpdate[stateIdx];
            oldestIndex = i;
         }
      }
      
      g_activeStates[oldestIndex] = state;
   }
   
   g_stateLastUpdate[state] = g_totalTrades;
   InvalidateHUDCache();
   
   if(EnableUnifiedBlockingSystem)
   {
      EvaluateAndUpdateBlockState(state);
   }
}

void CleanMemory()
{
   if(!AutoCleanMemory) return;
   
   // ✅ FIX #29: Verificar contador (incrementado em OnTradeTransaction)
   if(g_memoryCleanCounter < CleanMemoryAfterTrades) return;
   
   // Resetar contador
   g_memoryCleanCounter = 0;
   
   Print("🧹 REORGANIZANDO MEMÓRIA...");
   
   // 🚨 FIX #22: Reorganizar por ÚLTIMA ATUALIZAÇÃO, não por ordem de estado
   // Mantém estados mais RECENTES no cache, evita "redescoberta"
   
   int totalStatesWithVisits = 0;
   
   // Primeiro, coletar TODOS estados com visitas
   int tempStates[];
   int tempCount = 0;
   ArrayResize(tempStates, NUM_STATES);
   
   for(int state = 0; state < NUM_STATES; state++)
   {
      if(g_stateVisits[state] > 0)
      {
         tempStates[tempCount] = state;
         tempCount++;
         totalStatesWithVisits++;
      }
   }
   
   // ✅ Ordenar por última atualização (mais recentes primeiro)
   // Bubble sort simples por g_stateLastUpdate
   for(int i = 0; i < tempCount - 1; i++)
   {
      for(int j = i + 1; j < tempCount; j++)
      {
         int stateA = tempStates[i];
         int stateB = tempStates[j];
         
         // Ordenar decrescente (mais recente primeiro)
         if(g_stateLastUpdate[stateB] > g_stateLastUpdate[stateA])
         {
            tempStates[i] = stateB;
            tempStates[j] = stateA;
         }
      }
   }
   
   // ✅ FIX #30: Preencher cache apenas com estados que TÊM visitas
   g_activeStatesCount = 0;
   for(int i = 0; i < tempCount && g_activeStatesCount < MaxMemoryStates; i++)
   {
      int state = tempStates[i];
      
      // Verificar novamente se tem visitas (proteção contra estados resetados)
      if(g_stateVisits[state] > 0)
      {
         g_activeStates[g_activeStatesCount] = state;
         g_activeStatesCount++;
      }
   }
   
   Print("✅ Memória reorganizada: ", g_activeStatesCount, " estados MAIS RECENTES mantidos no cache");
   Print("   Total estados com visitas: ", totalStatesWithVisits);
   if(totalStatesWithVisits > MaxMemoryStates)
   {
      Print("   ⚠️ ", (totalStatesWithVisits - MaxMemoryStates), " estados mais antigos fora do cache (mas preservados na memória)");
   }
   
   // Salvar estado reorganizado
   SaveState();
}

