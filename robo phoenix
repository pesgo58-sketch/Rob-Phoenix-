//+------------------------------------------------------------------+
//| Calcula tamanho do lote baseado em % da banca (FIX #35)          |
//+------------------------------------------------------------------+
double CalculateDynamicLotSize(int state)
{
   double lot = LotSize;  // Valor padrão
   
   if(UsePercentRisk)
   {
      // Obter saldo da conta
      double balance = AccountInfoDouble(ACCOUNT_BALANCE);
      if(balance <= 0) balance = InitialBalance;
      
      // Calcular risco em dólares
      double riskAmount = balance * (RiskPercentPerTrade / 100.0);
      
      // Obter valor do pip
      double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
      double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
      double pointValue = (tickValue / tickSize);
      
      // Calcular lote baseado no risco e stop loss
      if(StopLossPipsForCalc > 0 && pointValue > 0)
      {
         double pipValue = pointValue * 10;  // 1 pip = 10 points
         lot = riskAmount / (StopLossPipsForCalc * pipValue);
      }
      
      // Aplicar limites
      lot = MathMax(lot, MinLotAllowed);
      lot = MathMin(lot, MaxAllowedLot);
      
      // Normalizar lote
      double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
      double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      
      lot = MathMax(lot, minLot);
      lot = MathMin(lot, maxLot);
      lot = MathFloor(lot / lotStep) * lotStep;
   }
   
   // Aplicar multiplicador por qualidade do estado (Smart Lot)
   if(EnableSmartLot && state >= 0 && state < NUM_STATES)
   {
      ENUM_STATE_QUALITY quality = GetStateQuality(state);
      
      switch(quality)
      {
         case STATE_QUALITY_ELITE:
            lot *= 1.5;  // 150% para estados ELITE
            break;
         case STATE_QUALITY_GOOD:
            lot *= 1.2;  // 120% para estados BONS
            break;
         case STATE_QUALITY_NEUTRAL:
            lot *= 1.0;  // 100% para estados NEUTROS
            break;
         case STATE_QUALITY_BAD:
            lot *= 0.5;  // 50% para estados RUINS (defensivo)
            break;
         case STATE_QUALITY_BLOCKED:
            lot = 0.0;   // Não opera estados bloqueados
            break;
      }
   }
   
   // Aplicar limite máximo final
   lot = MathMin(lot, MaxAllowedLot);
   
   // Normalizar novamente após multiplicação
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   lot = MathFloor(lot / lotStep) * lotStep;
   
   return lot;
}

//+------------------------------------------------------------------+
//| Verifica e atualiza circuit breakers (FIX #35)                   |
//+------------------------------------------------------------------+
bool CheckCircuitBreakers()
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   
   // ──────────────────────────────────────────────────────────────
   // RESET DIÁRIO
   // ──────────────────────────────────────────────────────────────
   datetime currentDay = StringToTime(StringFormat("%04d.%02d.%02d", dt.year, dt.mon, dt.day));
   
   if(currentDay > g_lastDayReset)
   {
      // Novo dia - resetar contadores
      g_lastDayReset = currentDay;
      g_dailyProfit = 0.0;
      g_dailyCircuitBreakerActive = false;
      g_dailyProfitTargetReached = false;
      
      Print("📅 NOVO DIA - Resetando circuit breakers diários");
      Print("   Balance: $", AccountInfoDouble(ACCOUNT_BALANCE));
   }
   
   // ──────────────────────────────────────────────────────────────
   // RESET SEMANAL (segunda-feira = 1)
   // ──────────────────────────────────────────────────────────────
   if(EnableWeeklyCircuitBreaker)
   {
      datetime currentWeek = currentDay - (dt.day_of_week * 86400);  // Segunda-feira da semana
      
      if(currentWeek > g_lastWeekReset)
      {
         g_lastWeekReset = currentWeek;
         g_weeklyProfit = 0.0;
         g_weeklyCircuitBreakerActive = false;
         
         Print("📅 NOVA SEMANA - Resetando circuit breakers semanais");
      }
   }
   
   // ──────────────────────────────────────────────────────────────
   // VERIFICAR CIRCUIT BREAKER DIÁRIO
   // ──────────────────────────────────────────────────────────────
   if(EnableDailyCircuitBreaker && !g_dailyCircuitBreakerActive)
   {
      double balance = AccountInfoDouble(ACCOUNT_BALANCE);
      if(balance <= 0) balance = InitialBalance;
      
      double dailyLossPercent = (g_dailyProfit / balance) * 100.0;
      
      if(dailyLossPercent < -MaxDailyLossPercent)
      {
         g_dailyCircuitBreakerActive = true;
         
         Print("🔴 CIRCUIT BREAKER DIÁRIO ATIVADO!");
         Print("   Perda Diária: $", g_dailyProfit, " (", dailyLossPercent, "%)");
         Print("   Limite: -", MaxDailyLossPercent, "%");
         Print("   ⏸️ OPERAÇÕES PAUSADAS ATÉ AMANHÃ");
         
         // Fechar todas as posições abertas (proteção)
         CloseAllPositions();
         
         return false;  // NÃO OPERAR
      }
   }
   
   // ──────────────────────────────────────────────────────────────
   // VERIFICAR META DE LUCRO DIÁRIA
   // ──────────────────────────────────────────────────────────────
   if(EnableDailyProfitTarget && !g_dailyProfitTargetReached)
   {
      double balance = AccountInfoDouble(ACCOUNT_BALANCE);
      if(balance <= 0) balance = InitialBalance;
      
      double dailyProfitPercent = (g_dailyProfit / balance) * 100.0;
      
      if(dailyProfitPercent >= DailyProfitTargetPercent)
      {
         g_dailyProfitTargetReached = true;
         
         Print("🎯 META DE LUCRO DIÁRIA ATINGIDA!");
         Print("   Lucro Diário: $", g_dailyProfit, " (", dailyProfitPercent, "%)");
         Print("   Meta: +", DailyProfitTargetPercent, "%");
         Print("   ⏸️ OPERAÇÕES PAUSADAS ATÉ AMANHÃ (proteção de lucros)");
         
         // Fechar todas as posições abertas (garantir lucro)
         CloseAllPositions();
         
         return false;  // NÃO OPERAR
      }
   }
   
   // ──────────────────────────────────────────────────────────────
   // VERIFICAR CIRCUIT BREAKER SEMANAL
   // ──────────────────────────────────────────────────────────────
   if(EnableWeeklyCircuitBreaker && !g_weeklyCircuitBreakerActive)
   {
      double balance = AccountInfoDouble(ACCOUNT_BALANCE);
      if(balance <= 0) balance = InitialBalance;
      
      double weeklyLossPercent = (g_weeklyProfit / balance) * 100.0;
      
      if(weeklyLossPercent < -MaxWeeklyLossPercent)
      {
         g_weeklyCircuitBreakerActive = true;
         
         Print("🔴 CIRCUIT BREAKER SEMANAL ATIVADO!");
         Print("   Perda Semanal: $", g_weeklyProfit, " (", weeklyLossPercent, "%)");
         Print("   Limite: -", MaxWeeklyLossPercent, "%");
         Print("   ⏸️ OPERAÇÕES PAUSADAS ATÉ PRÓXIMA SEMANA");
         
         CloseAllPositions();
         
         return false;  // NÃO OPERAR
      }
   }
   
   // ──────────────────────────────────────────────────────────────
   // VERIFICAR SE JÁ ESTÁ ATIVO
   // ──────────────────────────────────────────────────────────────
   if(g_dailyCircuitBreakerActive)
   {
      return false;  // Circuit breaker diário ativo
   }
   
   if(g_dailyProfitTargetReached)
   {
      return false;  // Meta diária atingida
   }
   
   if(g_weeklyCircuitBreakerActive)
   {
      return false;  // Circuit breaker semanal ativo
   }
   
   return true;  // PODE OPERAR
}

